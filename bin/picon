#!/usr/bin/env bash
set -euo pipefail

# Run the Pi coding agent in a container with access only to the directories
# you mount. Installed standalone, so this script never builds an image; use
# bin/build from a clone of the repository if you want to build one locally.

PICON_VERSION="1.0.0"
PICON_IMAGE="${PICON_IMAGE:-ghcr.io/rafdls/pi-container:latest}"
PICON_HOME_VOLUME="picon-home"

# Path Docker Desktop and OrbStack expose the host SSH agent on, inside the container.
CONTAINER_SSH_SOCK=/run/host-services/ssh-auth.sock

usage() {
  cat <<'USAGE'
Usage:
  picon <dir1> [dir2 ...] [-- <pi args>]
  picon --pull
  picon --version

Examples:
  picon ~/dev/my-project
  picon ~/dev/my-project -- chat
  picon ~/dev/app ~/dev/shared-lib ~/dev/config -- some pi args

Everything before -- is a host directory to mount; the first is the primary
workspace and becomes the working directory. Each directory is mounted at
/workspace/<basename>, so basenames must be unique. Everything after -- is
passed to pi.

Options:
  --pull      Download the latest image, then exit.
  --version   Print the picon version and image reference, then exit.
  --help      Show this message.

Environment:
  PICON_IMAGE   Image to run. Default: ghcr.io/rafdls/pi-container:latest
  PI_AGENT_DIR  Pi's agent configuration (AGENT.md, skills, extensions),
                mounted into the container. Default: ~/.pi/agent
USAGE
}

die() {
  echo "Error: $1" >&2
  exit 1
}

require_docker() {
  command -v docker >/dev/null 2>&1 \
    || die "docker is not installed. Install Docker Desktop or OrbStack, then try again."
  docker info >/dev/null 2>&1 \
    || die "cannot talk to the Docker daemon. Start Docker Desktop or OrbStack, then try again."
}

pull_image() {
  echo "Pulling $PICON_IMAGE ..." >&2
  docker pull "$PICON_IMAGE" >&2 \
    || die "could not pull $PICON_IMAGE. Check your network, or build the image locally with bin/build from a clone of the repository."
}

# Download the image the first time it is needed. A locally built image with the
# same name is used as-is and never overwritten by a pull.
ensure_image() {
  if docker image inspect "$PICON_IMAGE" >/dev/null 2>&1; then
    return 0
  fi
  pull_image
}

case "${1:-}" in
  --help | -h)
    usage
    exit 0
    ;;
  --version)
    echo "picon $PICON_VERSION"
    echo "image $PICON_IMAGE"
    exit 0
    ;;
  --pull)
    require_docker
    pull_image
    exit 0
    ;;
esac

if [ $# -lt 1 ]; then
  usage >&2
  exit 1
fi

# Split arguments into mount directories (before --) and pi arguments (after --).
MOUNT_DIRS=()
PI_ARGS=()
seen_separator=0
for arg in "$@"; do
  if [ "$seen_separator" -eq 1 ]; then
    PI_ARGS+=("$arg")
  elif [ "$arg" = "--" ]; then
    seen_separator=1
  else
    MOUNT_DIRS+=("$arg")
  fi
done

if [ "${#MOUNT_DIRS[@]}" -lt 1 ]; then
  echo "Error: at least one directory to mount is required." >&2
  echo "" >&2
  usage >&2
  exit 1
fi

# Resolve directories, reject non-directories, and detect basename collisions.
# Two parallel indexed arrays rather than an associative one, because macOS
# ships bash 3.2, which has no `declare -A`.
MOUNT_ARGS=()
seen_names=()
seen_paths=()
WORKSPACE_NAME=""
for dir in "${MOUNT_DIRS[@]}"; do
  [ -d "$dir" ] || die "not a directory: $dir"
  abs_dir="$(cd "$dir" && pwd)"
  name="$(basename "$abs_dir")"
  for i in ${seen_names[@]+"${!seen_names[@]}"}; do
    if [ "${seen_names[$i]}" = "$name" ]; then
      echo "Error: duplicate mount name \"$name\" (both map to /workspace/$name):" >&2
      echo "  ${seen_paths[$i]}" >&2
      echo "  $abs_dir" >&2
      exit 1
    fi
  done
  seen_names+=("$name")
  seen_paths+=("$abs_dir")

  # The first directory is the primary workspace and sets the working directory.
  [ -n "$WORKSPACE_NAME" ] || WORKSPACE_NAME="$name"
  MOUNT_ARGS+=("-v" "$abs_dir:/workspace/$name")
done

# Pi's agent configuration, version controlled separately on the host.
PI_AGENT_DIR_INPUT="${PI_AGENT_DIR:-$HOME/.pi/agent}"
PI_AGENT_DIR_INPUT="${PI_AGENT_DIR_INPUT/#\~/$HOME}"
mkdir -p "$PI_AGENT_DIR_INPUT"
PI_AGENT_DIR_RESOLVED="$(cd "$PI_AGENT_DIR_INPUT" && pwd)"
MOUNT_ARGS+=("-v" "$PI_AGENT_DIR_RESOLVED:/home/piagent/.pi/agent")

# Pi's own state, kept in a named volume rather than on the host.
MOUNT_ARGS+=("-v" "$PICON_HOME_VOLUME:/home/piagent")

# Forward the host SSH agent so git push and pull work without copying keys into
# the container. On macOS, Docker Desktop and OrbStack expose the agent at a
# fixed path that does not exist on the host filesystem, so it is mounted by
# path rather than checked for. Elsewhere, mount the host's own agent socket.
ENV_ARGS=("-e" "HOME=/home/piagent")
EXTRA_ARGS=()
if [ "$(uname -s)" = "Darwin" ]; then
  MOUNT_ARGS+=("-v" "$CONTAINER_SSH_SOCK:$CONTAINER_SSH_SOCK")
  ENV_ARGS+=("-e" "SSH_AUTH_SOCK=$CONTAINER_SSH_SOCK")
  # Docker Desktop owns the forwarded socket as root:root with mode 660, so the
  # non-root container user needs group 0 to read it.
  EXTRA_ARGS+=("--group-add" "0")
elif [ -S "${SSH_AUTH_SOCK:-}" ]; then
  MOUNT_ARGS+=("-v" "$SSH_AUTH_SOCK:$CONTAINER_SSH_SOCK")
  ENV_ARGS+=("-e" "SSH_AUTH_SOCK=$CONTAINER_SSH_SOCK")
else
  echo "Warning: no SSH agent found. Git over SSH will not work inside the container." >&2
fi

# The host git identity (name and email), read-only, so commits made inside the
# container are attributed correctly. Git reads /dev/null as an empty config.
HOST_GITCONFIG=/dev/null
if [ -f "$HOME/.gitconfig" ]; then
  HOST_GITCONFIG="$HOME/.gitconfig"
fi
MOUNT_ARGS+=("-v" "$HOST_GITCONFIG:/home/piagent/.gitconfig:ro")

require_docker
ensure_image

exec docker run --rm -it \
  --workdir "/workspace/$WORKSPACE_NAME" \
  ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} \
  "${MOUNT_ARGS[@]}" \
  "${ENV_ARGS[@]}" \
  "$PICON_IMAGE" \
  pi ${PI_ARGS[@]+"${PI_ARGS[@]}"}
