#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage:"
  echo "  bin/pi-agent /absolute/path/to/project"
  echo ""
  echo "Example:"
  echo "  bin/pi-agent ~/dev/my-project"
  echo ""
  echo "Pi's agent config directory (AGENT.md, skills, extensions) defaults to"
  echo "~/.pi/agent. Override it by setting PI_AGENT_DIR in .env."
  exit 1
fi

WORKSPACE_DIR="$(cd "$1" && pwd)"
WORKSPACE_NAME="$(basename "$WORKSPACE_DIR")"

shift
PI_ARGS=("$@")

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Pick up PI_AGENT_DIR from .env, if present, without letting Compose's own
# .env handling deal with `~` (which Compose does not expand).
if [ -f "$REPO_ROOT/.env" ]; then
  # shellcheck disable=SC1090
  ENV_PI_AGENT_DIR="$(grep -E '^PI_AGENT_DIR=' "$REPO_ROOT/.env" | tail -n1 | cut -d= -f2-)"
fi

PI_AGENT_DIR_INPUT="${ENV_PI_AGENT_DIR:-$HOME/.pi/agent}"
PI_AGENT_DIR_INPUT="${PI_AGENT_DIR_INPUT/#\~/$HOME}"

mkdir -p "$PI_AGENT_DIR_INPUT"
PI_AGENT_DIR="$(cd "$PI_AGENT_DIR_INPUT" && pwd)"

# Source the developer's own host git identity (name/email) read-only so commits
# made inside the container are attributed correctly. Nothing is hard-coded or
# committed to this repo. If the host has no ~/.gitconfig, fall back to /dev/null,
# which git reads as an empty config (no identity, no error).
if [ -f "$HOME/.gitconfig" ]; then
  HOST_GITCONFIG="$HOME/.gitconfig"
else
  HOST_GITCONFIG=/dev/null
fi

cd "$REPO_ROOT"

WORKSPACE_DIR="$WORKSPACE_DIR" WORKSPACE_NAME="$WORKSPACE_NAME" PI_AGENT_DIR="$PI_AGENT_DIR" HOST_GITCONFIG="$HOST_GITCONFIG" docker compose run --rm pi-agent pi "${PI_ARGS[@]}"
