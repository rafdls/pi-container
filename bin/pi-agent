#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "Usage:"
  echo "  bin/pi-agent /absolute/path/to/project"
  echo ""
  echo "Example:"
  echo "  bin/pi-agent ~/dev/my-project"
  echo ""
  echo "Pi's agent config directory (AGENT.md, skills, extensions) defaults to"
  echo "~/.pi/agent. Override it by setting PI_AGENT_DIR in .env."
  exit 1
fi

WORKSPACE_DIR="$(cd "$1" && pwd)"

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Pick up PI_AGENT_DIR from .env, if present, without letting Compose's own
# .env handling deal with `~` (which Compose does not expand).
if [ -f "$REPO_ROOT/.env" ]; then
  # shellcheck disable=SC1090
  ENV_PI_AGENT_DIR="$(grep -E '^PI_AGENT_DIR=' "$REPO_ROOT/.env" | tail -n1 | cut -d= -f2-)"
fi

PI_AGENT_DIR_INPUT="${ENV_PI_AGENT_DIR:-$HOME/.pi/agent}"
PI_AGENT_DIR_INPUT="${PI_AGENT_DIR_INPUT/#\~/$HOME}"

mkdir -p "$PI_AGENT_DIR_INPUT"
PI_AGENT_DIR="$(cd "$PI_AGENT_DIR_INPUT" && pwd)"

cd "$REPO_ROOT"

WORKSPACE_DIR="$WORKSPACE_DIR" PI_AGENT_DIR="$PI_AGENT_DIR" docker compose run --rm pi-agent pi
