#!/usr/bin/env bash
set -euo pipefail

# Build the picon image from this repository's Dockerfile, tagged with the same
# name picon looks up so a local build is used instead of the published image.
#
# Usage:
#   bin/build             # normal build (uses the Docker layer cache)
#   bin/build --no-cache  # force a fresh build, ignoring the cache

PICON_IMAGE="${PICON_IMAGE:-ghcr.io/rafdls/pi-container:latest}"

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

docker build -t "$PICON_IMAGE" "$@" .

echo ""
echo "Built $PICON_IMAGE. Run it with:"
echo "  bin/picon <directory>"
