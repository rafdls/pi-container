#!/usr/bin/env bash
set -euo pipefail

# Build the pi-agent Docker image.
#
# Usage:
#   bin/build            # normal build (uses Docker layer cache)
#   bin/build --no-cache # force a fresh build, ignoring the cache

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

docker compose build "$@" pi-agent
